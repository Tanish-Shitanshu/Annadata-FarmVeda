# Optional: enables the Fasal Guru AI chat assistant.
# Without this set, the chat page still runs but explains that AI chat is unavailable
# and falls back to the rule-based advisory modules instead.
# Get a free key at https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional: overrides the default SQLite database path.
FARMVEDA_DB_PATH=farmveda.db

# Optional: Gemini model used by Fasal Guru. Model names change over time; if chat
# reports "model not found", set this to one your key can use (see ai.google.dev/gemini-api/docs/models).
# Leave empty to use the built-in fallback list.
GEMINI_MODEL=
